{
  "openapi": "3.0.4",
  "info": { "title": "Test Agent Tools API", "version": "1.0" },
  "paths": {
    "/agent/widget-status": {
      "get": {
        "operationId": "GetWidgetStatus",
        "security": [{ "agent": [] }],
        "parameters": [
          {
            "name": "widgetId",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "x-agent-tool-properties": {
          "name": "get_widget_status",
          "title": "Get Widget Status",
          "description": "Returns the current status of a widget.",
          "permissionScope": "test-tool-scope"
        }
      }
    },
    "/agent/gadget-status": {
      "get": {
        "operationId": "GetGadgetStatus",
        "security": [{ "agent": [] }],
        "parameters": [
          {
            "name": "gadgetId",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "x-agent-tool-properties": {
          "name": "get_gadget_status",
          "title": "Get Gadget Status",
          "description": "Returns the current status of a gadget.",
          "permissionScope": "test-tool-scope"
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "agent": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://example.com/oauth2/token",
            "scopes": {}
          }
        }
      }
    }
  }
}
